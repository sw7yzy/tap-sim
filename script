local pages, tabButtons, currentPage = {}, {}, nil
local function switchTo(name)
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for n, b in pairs(tabButtons) do
        local active = (n == name)
        tween(b.frame, { BackgroundColor3 = active and C.card or C.sidebar }, 0.12)
        b.label.TextColor3 = active and C.text or C.textDim
        b.icon.TextColor3 = active and C.accent2 or C.muted
        b.bar.BackgroundTransparency = active and 0 or 1
    end
    currentPage = name
end

