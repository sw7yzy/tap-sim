local function priceFmt(n)
    n = tonumber(n) or 0
    if n < 1000 then return tostring(math.floor(n)) end
    local tier = math.floor(math.log(n, 1000))
    tier = math.min(tier, #SUFFIXES_FMT - 1)
    return string.format("%.1f%s", n / (1000 ^ tier), SUFFIXES_FMT[tier + 1])
end
