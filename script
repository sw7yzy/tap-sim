local DWELL, BETWEEN, COOLDOWN, TRAVEL_WAIT = 0.75, 0.4, 30 * 60, 4
local MAX_ATTEMPTS, BLEND = 3, 0.5
local function travelTo(island) pcall(function() Travel:InvokeServer({ Source = "Portal", Island = island }) end) end

local function getHouses()
    local list = {}
    local island = workspace:FindFirstChild("HalloweenIsland")
    if not island then return list end
    for _, m in ipairs(island:GetChildren()) do
        local id = m:GetAttribute("HouseId")
        if id then
            local porch = m:FindFirstChild("Porch", true)
            local door  = m:FindFirstChild("Door", true)
            local porchPart = porch and porch:FindFirstChildWhichIsA("BasePart", true)
            if porchPart and door then
                local dp = door:GetPivot().Position
                local pp = porchPart.Position
                local x = pp.X + (dp.X - pp.X) * BLEND
                local z = pp.Z + (dp.Z - pp.Z) * BLEND
                local y = pp.Y + porchPart.Size.Y/2 + 3
                table.insert(list, {id = id, cf = CFrame.new(x, y, z)})
            end
        end
    end
    table.sort(list, function(a, b) return a.id < b.id end)
    return list
end
local function onHalloweenIsland() return #getHouses() >= 11 end
local function waitForHalloween()
    local t = 0
    while t < 15 do if onHalloweenIsland() then task.wait(1); return true end; task.wait(0.5); t = t + 0.5 end
    return false
end
local function tpTo(cf)
    local c = lp.Character; local h = c and c:FindFirstChild("HumanoidRootPart")
    if h then h.CFrame = cf end
end

task.spawn(function()
    while true do
        if AutoKnock.enabled then
            local originCF
            local c = lp.Character; local h = c and c:FindFirstChild("HumanoidRootPart")
            if h then originCF = h.CFrame end
            local ready = true
            if not onHalloweenIsland() then
                setStatus(knockStatus, knockDot, "traveling to Halloween…", C.accent2)
                travelTo("Halloween")
                if not waitForHalloween() then
                    setStatus(knockStatus, knockDot, "load failed · retry 10s", C.bad)
                    task.wait(10); ready = false
                else task.wait(TRAVEL_WAIT) end
            end
            if ready then
                local houses = getHouses()
                local claimed, attempts = {}, {}
                local keepGoing = true
                while AutoKnock.enabled and keepGoing do
                    local remaining = {}
                    for _, hs in ipairs(houses) do
                        if not claimed[hs.id] and (attempts[hs.id] or 0) < MAX_ATTEMPTS then
                            table.insert(remaining, hs)
                        end
                    end
                    if #remaining == 0 then keepGoing = false
                    else
                        for _, hs in ipairs(remaining) do
                            if AutoKnock.enabled then
                                attempts[hs.id] = (attempts[hs.id] or 0) + 1
                                setStatus(knockStatus, knockDot, ("claiming %s"):format(hs.id), C.accent2)
                                tpTo(hs.cf); task.wait(DWELL)
                                local ok, res = pcall(function() return Knock:InvokeServer(hs.id) end)
                                if ok and res ~= false and res ~= nil then claimed[hs.id] = true end
                                task.wait(BETWEEN)
                            end
                        end
                    end
                end
                local n = 0; for _ in pairs(claimed) do n = n + 1 end
                setStatus(knockStatus, knockDot, ("claimed %d/%d"):format(n, #houses), C.good)
                if originCF then
                    local cc = lp.Character; local hh = cc and cc:FindFirstChild("HumanoidRootPart")
