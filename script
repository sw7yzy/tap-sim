-- Config files
local CONFIG_DIR = "TSReborn"
local CONFIG_SUB = CONFIG_DIR .. "/configs"
local AUTOLOAD_FILE = CONFIG_DIR .. "/autoload.txt"
if makefolder then pcall(makefolder, CONFIG_DIR); pcall(makefolder, CONFIG_SUB) end
local function listConfigs()
    local out = {}
    if listfiles and isfolder and isfolder(CONFIG_SUB) then
        for _, path in ipairs(listfiles(CONFIG_SUB)) do
            local name = path:match("([^/\\]+)%.json$")
            if name then table.insert(out, name) end
        end
    end
    table.sort(out)
    return out
end

local UISetters = {}
local refreshCheckRows = {}

local function snapshot()
    return {
        AutoKnock = { enabled = AutoKnock.enabled },
        AutoEnchant = { enabled = AutoEnchant.enabled, slot = AutoEnchant.slot, wanted = AutoEnchant.wanted },
        AutoBoss = { enabled = AutoBoss.enabled },
        AntiAFK = { enabled = AntiAFK.enabled },
        Webhook = {
            enabled = Webhook.enabled, url = Webhook.url,
            pingMode = Webhook.pingMode, customPing = Webhook.customPing,
            rarities = Webhook.rarities, tiers = Webhook.tiers,
        },
    }
end
local function applyConfig(cfg)
    if type(cfg) ~= "table" then return end
    local function set(k, v) if UISetters[k] then UISetters[k](v) end end
    if cfg.AutoKnock then set("AutoKnock.enabled", cfg.AutoKnock.enabled) end
    if cfg.AutoBoss then set("AutoBoss.enabled", cfg.AutoBoss.enabled) end
    if cfg.AntiAFK then set("AntiAFK.enabled", cfg.AntiAFK.enabled) end
    if cfg.AutoEnchant then
        set("AutoEnchant.enabled", cfg.AutoEnchant.enabled)
        set("AutoEnchant.slot", cfg.AutoEnchant.slot or 1)
        AutoEnchant.wanted = cfg.AutoEnchant.wanted or {}
    end
    if cfg.Webhook then
        set("Webhook.enabled", cfg.Webhook.enabled)
        set("Webhook.url", cfg.Webhook.url or "")
        set("Webhook.pingMode", cfg.Webhook.pingMode or "None")
        set("Webhook.customPing", cfg.Webhook.customPing or "")
        Webhook.rarities = cfg.Webhook.rarities or Webhook.rarities
        Webhook.tiers = cfg.Webhook.tiers or Webhook.tiers
    end
    for _, fn in ipairs(refreshCheckRows) do fn() end
end
local function saveConfig(name) if writefile then writefile(CONFIG_SUB.."/"..name..".json", HS:JSONEncode(snapshot())); return true end end
local function loadConfigFile(name)
    if not (readfile and isfile) then return false end
    local p = CONFIG_SUB.."/"..name..".json"
    if not isfile(p) then return false end
    local ok, data = pcall(function() return HS:JSONDecode(readfile(p)) end)
    if not ok then return false end
    applyConfig(data); return true
end
local function deleteConfigFile(name)
    if delfile and isfile then
        local p = CONFIG_SUB.."/"..name..".json"
        if isfile(p) then delfile(p); return true end
    end
end
local function setAutoload(name) if writefile then writefile(AUTOLOAD_FILE, name or "") end end
local function getAutoload() if isfile and isfile(AUTOLOAD_FILE) then return readfile(AUTOLOAD_FILE) end return "" end

