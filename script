    end)
    if ok and data and data.data and data.data[1] then avatarUrl = data.data[1].imageUrl end
end)

local queue, running = {}, false
local function processQueue()
    if running then return end
    running = true
    task.spawn(function()
        local req = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
        if not req then setStatus(whStatus, whDot, "no HTTP function in executor", C.bad); running = false; return end
        while #queue > 0 do
            local payload = table.remove(queue, 1)
            local res
            local ok = pcall(function()
                res = req({ Url = Webhook.url, Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HS:JSONEncode(payload) })
            end)
            if ok and res then
                local code = res.StatusCode or res.Status or 0
                if code == 429 then
                    local wait = 1
                    pcall(function()
                        local d = HS:JSONDecode(res.Body)
                        if d.retry_after then wait = d.retry_after + 0.1 end
                    end)
                    table.insert(queue, 1, payload); task.wait(wait)
                elseif code >= 300 then
                    setStatus(whStatus, whDot, "HTTP "..code, C.bad)
                else
                    setStatus(whStatus, whDot, "sent · "..os.date("%H:%M:%S"), C.good)
                end
            else setStatus(whStatus, whDot, "send error", C.bad) end
            task.wait(0.6)
        end
        running = false
    end)
end
local function send(payload)
    if Webhook.url == "" then setStatus(whStatus, whDot, "no webhook URL set", C.bad); return end
    table.insert(queue, payload); processQueue()
end

local RARITY_COLOR = { Common=0x9E9E9E, Rare=0x4FC3F7, Epic=0xAB47BC, Legendary=0xFFB300, Mythical=0xE91E63, Secret=0xF44336 }
local RARITY_EMOJI = { Common="⚪", Rare="🔵", Epic="🟣", Legendary="🟡", Mythical="🩷", Secret="⭐" }
local scriptStart = os.clock()
local sessionEggs = 0

local function pingContent()
    if Webhook.pingMode == "@everyone" then return "@everyone"
    elseif Webhook.pingMode == "@here" then return "@here"
    elseif Webhook.pingMode == "User" and Webhook.customPing ~= "" then
        return "<@" .. Webhook.customPing:gsub("[^%d]", "") .. ">"
    end
    return nil
end

local function buildPayload(pet, eggName, coins)
    local rarity = pet.Rarity or "Unknown"
    local tier = pet.Tier or "Normal"
    local mutation = pet.Mutation
    local color = RARITY_COLOR[rarity] or 0x7E57C2
    local petDisplay = pet.Name or "?"
    if mutation then petDisplay = mutation .. " " .. petDisplay end

    local fields = {
        { name = "🐾 Pet",     value = petDisplay,       inline = true },
        { name = "💎 Rarity",  value = rarity,            inline = true },
        { name = "🏷️ Tier",    value = tier,              inline = true },
        { name = "🎲 Chance",  value = "1 in " .. fmtNum(pet.OneIn or 0), inline = true },
        { name = "⚡ Power",   value = fmtNum(pet.Power or 0), inline = true },
        { name = "🥚 Egg",     value = eggName or "?",    inline = true },
        { name = "💰 Coins",   value = fmtNum(coins or 0), inline = true },
        { name = "📈 Session", value = sessionEggs .. " eggs", inline = true },
        { name = "⏱️ Runtime", value = fmtRuntime(os.clock() - scriptStart), inline = true },
    }
    if mutation then table.insert(fields, 3, { name = "✨ Mutation", value = mutation, inline = true }) end

    local embed = {
        title = ("%s %s HATCHED!"):format(RARITY_EMOJI[rarity] or "💜", rarity:upper()),
        color = color, fields = fields,
        footer = { text = ("%s · aka %s"):format(lp.Name, lp.DisplayName or lp.Name), icon_url = avatarUrl },
        timestamp = DateTime.now():ToIsoDate(),
    }
    local petImg = getPetImage(pet.Name, tier)
    if petImg then embed.thumbnail = { url = petImg } end

    return {
        username = "Pet Tracker", avatar_url = avatarUrl,
        content = pingContent(),
        allowed_mentions = { parse = { "everyone", "users" } },
        embeds = { embed },
    }
end

