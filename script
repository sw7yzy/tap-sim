    track.Size = UDim2.new(0, 46, 0, 24); track.Position = UDim2.new(1, -46, 0.5, -12)
    track.Text = ""; track.AutoButtonColor = false
    track.BackgroundColor3 = initial and C.accent1 or C.cardAlt; track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame", track)
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = initial and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
