local SUFFIXES = { "","K","M","B","T","Qa","Qi","Sx","Sp","Oc","No","Dc","UDc","DDc","TDc","QaDc","QiDc","SxDc","SpDc","OcDc","Vg","UVg","DVg","TVg","QaVg","QiVg","SxVg","SpVg","OcVg","NVg","Tg" }
local function fmtNum(n)
    n = tonumber(n) or 0
    if n < 1000 then return tostring(math.floor(n)) end
    local tier = math.floor(math.log(n, 1000))
    tier = math.min(tier, #SUFFIXES - 1)
    return string.format("%.2f%s", n / (1000 ^ tier), SUFFIXES[tier + 1])
end
local function fmtRuntime(s)
    local h, m = math.floor(s/3600), math.floor((s%3600)/60)
    local sec = math.floor(s%60)
    if h > 0 then return ("%dh %dm"):format(h, m) end
    if m > 0 then return ("%dm %ds"):format(m, sec) end
    return ("%ds"):format(sec)
end

local urlCache = {}
local function assetToUrl(assetUri)
    if not assetUri then return nil end
    local id = tostring(assetUri):match("(%d+)")
    if not id then return nil end
    if urlCache[id] ~= nil then return urlCache[id] or nil end
    local ok, data = pcall(function()
        return HS:JSONDecode(game:HttpGet(("https://thumbnails.roblox.com/v1/assets?assetIds=%s&size=150x150&format=Png"):format(id)))
    end)
    if ok and data and data.data and data.data[1] and data.data[1].imageUrl then
        urlCache[id] = data.data[1].imageUrl
    else urlCache[id] = false end
    return urlCache[id] or nil
end
local function getImageFromEntry(entry, tier)
    if not entry then return nil end
    local function try(v) if v and v ~= "" then return assetToUrl(v) end end
    if tier == "Golden" then
        local url = try(entry.ImageGolden); if url then return url end
    end
    return try(entry.Image) or try(entry.Portrait) or try(entry.Icon)
end
local function getPetImage(petName, tier)
    local url = getImageFromEntry(PetVisual[petName], tier)
    if url then return url end
    return getImageFromEntry(OriginalPets[petName], tier)
end

local avatarUrl = nil
