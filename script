end

EggHatchResult.OnClientEvent:Connect(function(data)
    if not Webhook.enabled then return end
    if type(data) ~= "table" or not data.Pets then return end
    sessionEggs = sessionEggs + (data.Rolls or 1)
    for _, pet in ipairs(data.Pets) do
        local rOk = Webhook.rarities[pet.Rarity or ""] or false
        local tOk = Webhook.tiers[pet.Tier or ""] or false
        if rOk and tOk then
            send(buildPayload(pet, data.Egg, data.Coins))
        end
    end
end)

