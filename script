    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local state = initial
    local function setVisual(v)
        state = v and true or false
        tween(track, { BackgroundColor3 = state and C.accent1 or C.cardAlt }, 0.2)
        tween(knob, { Position = state and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9) }, 0.25, Enum.EasingStyle.Back)
    end
    track.MouseButton1Click:Connect(function() setVisual(not state); callback(state) end)
    if setterKey then UISetters[setterKey] = function(v) setVisual(v); callback(state) end end
