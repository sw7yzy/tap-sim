local pages, tabButtons, currentPage = {}, {}, nil
local function switchTo(name)
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for n, b in pairs(tabButtons) do
        local active = (n == name)
        tween(b.frame, { BackgroundColor3 = active and C.card or C.sidebar }, 0.15)
        b.label.TextColor3 = active and C.text or C.textDim
        b.icon.TextColor3 = active and C.accent1 or C.muted
        tween(b.bar, { BackgroundTransparency = active and 0 or 1, Size = active and UDim2.new(0,4,0,24) or UDim2.new(0,4,0,8) }, 0.2)
    end
    currentPage = name
end

