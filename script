-- Hatch tracker + continuous auto-hatch loop
local lastHatch = { Egg = nil, Count = 8, Seq = 0, Auto = true }
local oldHatch
oldHatch = hookmetamethod(HatchRE, "__namecall", function(self, ...)
    if self == HatchRE and getnamecallmethod() == "FireServer" then
        local a = ({...})[1]
        if type(a) == "table" and a.Egg then
            lastHatch.Egg = a.Egg
            lastHatch.Count = a.Count or lastHatch.Count
            if a.Seq then lastHatch.Seq = math.max(lastHatch.Seq, a.Seq) end
            if a.Auto ~= nil then lastHatch.Auto = a.Auto end
        end
    end
    return oldHatch(self, ...)
end)

local function findEggModel(name)
    local f = workspace:FindFirstChild("Eggs")
    return f and f:FindFirstChild(name)
end
local function fireHatch(eggName)
    lastHatch.Seq = lastHatch.Seq + 1
    pcall(function() HatchRE:FireServer({ Egg = eggName, Count = 8, Seq = lastHatch.Seq, Auto = true }) end)
end
local function tpAndHatch(eggName)
    local info = EGGS[eggName]
    if not info then return end
    if info.Island and not findEggModel(eggName) then
        pcall(function() Travel:InvokeServer({ Source = "Portal", Island = info.Island }) end)
        local t = 0
        while t < 15 and not findEggModel(eggName) do task.wait(0.5); t = t + 0.5 end
    end
    local egg = findEggModel(eggName)
    if not egg then return end
    local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0)) end
    task.wait(0.3)
    EggHub.current = eggName
    lastHatch.Egg = eggName; lastHatch.Count = 8; lastHatch.Auto = true
    fireHatch(eggName)
end
-- Continuous loop: fire HatchRE every 1.5s while an egg is active
task.spawn(function()
    while true do
        task.wait(1.5)
        if EggHub.current and EggHub.autoHatch then
            pcall(fireHatch, EggHub.current)
        end
    end
end)
local function resumeHatch()
    if EggHub.current then tpAndHatch(EggHub.current) end
end

