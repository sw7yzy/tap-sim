task.spawn(function()
    local function hasAncestorNamed(inst, needle)
        local p = inst
        while p and p ~= game do
            if type(p.Name) == "string" and p.Name:lower():find(needle, 1, true) then return true end
            p = p.Parent
        end
        return false
    end
    local function findCandyText()
        -- Preferred: HalloweenShop menu's "Candy" label (shows formatted total e.g. "7,609")
        local tabs = lp.PlayerGui:FindFirstChild("Tabs")
        local hs   = tabs and tabs:FindFirstChild("HalloweenShop")
        local menu = hs and hs:FindFirstChild("Menu")
        local candy = menu and menu:FindFirstChild("Candy")
        if candy and candy:IsA("TextLabel") then return candy end
        -- Fallback: scan anything in a candy-named ancestor
        local best, bestScore = nil, -1
        for _, d in ipairs(lp.PlayerGui:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text and d.Text:match("[%d,]") and not d.Text:find("/") then
                if hasAncestorNamed(d, "candycorn") or hasAncestorNamed(d, "candy") then
                    local score = (d.Visible and 100 or 0) + #d.Text
                    if score > bestScore then best, bestScore = d, score end
                end
            end
        end
        return best
    end
    local function findCandyImage()
        for _, d in ipairs(lp.PlayerGui:GetDescendants()) do
            if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" then
                if hasAncestorNamed(d, "candycorn") or d.Name:lower():find("candy") then
                    return d.Image
                end
            end
        end
    end
